DATABASE_URL=postgresql+asyncpg://ethnowalk_user:ethnodb26@localhost:5432/NoB_db
DATABASE_URL_SYNC=postgresql://ethnowalk_user:ethnodb26@localhost:5432/NoB_db
SECRET_KEY=nob-secret-key-change-this-before-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
AUDIO_DIR=./media/audio
IMAGE_DIR=./media/images
BASE_URL=http://localhost:8000
MOCK_PAYMENTS=True
SIGNED_URL_EXPIRE_SECONDS=3600

# Media URL signing key. Defaults to SECRET_KEY when not set.
# Set explicitly in production to rotate media signing independently of JWTs.
MEDIA_SIGNING_KEY=

# CORS: comma-separated list of allowed origins. Never use * with credentials.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8081

# Enable SQLAlchemy query logging (never enable in production \u2014 logs JWTs/hashes)
DEBUG=true