# Copy to .env and fill in. Never commit .env.
ENVIRONMENT=development          # development | staging | production

DATABASE_URL=postgresql+asyncpg://nob_user:CHANGE_ME@localhost:5432/nob_db
DATABASE_URL_SYNC=postgresql://nob_user:CHANGE_ME@localhost:5432/nob_db

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-this-generate-a-random-48-char-value
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

AUDIO_DIR=./media/audio
IMAGE_DIR=./media/images
BASE_URL=http://localhost:8000

# Payments: MOCK_PAYMENTS=true completes purchases instantly (development only).
MOCK_PAYMENTS=true
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
SIGNED_URL_EXPIRE_SECONDS=3600

# Media URL signing key. Defaults to SECRET_KEY when empty.
MEDIA_SIGNING_KEY=

# Email / OTP. console = print to server log (dev only), smtp = real delivery.
EMAIL_BACKEND=console
EMAIL_FROM=NoB <no-reply@nob.app>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
# Development only: return the OTP in the API response so you can test without email.
EXPOSE_DEV_OTP=true

# Admin account created by `python -m app.seed`
ADMIN_EMAIL=admin@nob.app
ADMIN_PASSWORD=

GOOGLE_CLIENT_ID=

# CORS: comma-separated list of allowed origins. Never use * with credentials.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8081

# SQL query logging (never in production: logs may contain tokens/hashes)
DEBUG=false
