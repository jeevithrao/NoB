# Copy to .env and adjust as needed. Never commit the real .env.

# Async URL (used by the app at runtime) and sync URL (used by Alembic)
DATABASE_URL=postgresql+asyncpg://nob_user:nob_password@localhost:5432/nob_db
DATABASE_URL_SYNC=postgresql+psycopg2://nob_user:nob_password@localhost:5432/nob_db

SECRET_KEY=change-this-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

AUDIO_DIR=./media/audio
IMAGE_DIR=./media/images
BASE_URL=http://localhost:8000

# Payments — leave True until Razorpay/Stripe keys exist. See routers/purchases.py.
MOCK_PAYMENTS=True
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

SIGNED_URL_EXPIRE_SECONDS=3600
